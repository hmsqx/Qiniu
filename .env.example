# 可选的 Ubuntu 镜像源，用于在 Docker 构建时加速或提高 apt 的可靠性
# 示例：
#   http://mirrors.aliyun.com/ubuntu
#   http://mirrors.tuna.tsinghua.edu.cn/ubuntu
#   http://mirrors.ustc.edu.cn/ubuntu
# 留空则使用官方默认镜像源
UBUNTU_MIRROR=

# ---- 数据库配置 ----
# 会在打包的时候将对应的账号密码等设置为数据库的参数
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_PORT=
MYSQL_HOST=

# ---- 腾讯云配置 ----
# 注意这个文件不应该提交到版本库中
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=

# ---- 模型存储路径（非密钥） ----
# 第一个是文件系统路径，第二个是 URL 路径
MODEL_FS_BASE_DIR=
MODEL_URL_BASE_PATH=

# ---- python服务的密钥 ----
DASHSCOPE_API_KEY=

# ---- 针对于前端的调用的API ----
API_UPSTREAM=
LLM_UPSTREAM=

# ---- 时区配置 ----
TZ=

# ---- 额外推荐可配置项（可选） ----
# 启动时是否总是尝试从种子目录拷贝模型（1=是，0=否）
ALWAYS_SEED_MODELS=
# 拷贝模型时是否覆盖已有文件（1=覆盖，0=不覆盖）
SEED_OVERWRITE=
# 模型种子目录（容器内路径）
SEED_MODELS_DIR=

# ---- py-server 的环境配置 ----
# 让 py-server 读取容器内的 .env（若你要使用 py-server/.env 文件，容器内路径通常是 /app/.env）
APP_ENV_FILE=
# 通义千问模型相关配置（如无需修改可保持默认）
QWEN_MODEL=
QWEN_IMAGE_EDIT_MODEL=
QWEN_COMPATIBLE_BASE_URL=
DASHSCOPE_BASE_HTTP_API_URL=
# 可选：调整 Python 服务运行参数
PY_HOST=
PY_PORT=
PY_RELOAD=
PY_LOG_LEVEL=
